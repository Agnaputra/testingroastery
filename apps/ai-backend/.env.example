# 52 Coffee & Roastery - AI Microservice Environment Configuration
ENVIRONMENT=development
PORT=8000

# OpenAI Responses API (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
RAG_TOP_K=3

# PostgreSQL with pgvector extension
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/testingroastery

# Customer commerce: isolated local database only.
CUSTOMER_COMMERCE_TEST_MODE=0
# Local-only trial of admin-verified inventory and destination shipping rates.
CUSTOMER_OPERATIONAL_TEST_MODE=0
CUSTOMER_TEST_SHIPPING_IDR=0
CUSTOMER_TEST_EMAIL_ALLOWLIST=
CUSTOMER_TEST_BEAN_STOCK_GRAMS=0
CUSTOMER_TEST_ACCESSORY_STOCK_UNITS=0
CUSTOMER_TEST_CUP_GRAMS=18
CUSTOMER_TEST_PAYMENT_HOURS=24
CUSTOMER_AUTH_URL=http://localhost:3000
CUSTOMER_GOOGLE_CLIENT_ID=
CUSTOMER_GOOGLE_CLIENT_SECRET=
CUSTOMER_GOOGLE_REDIRECT_URI=http://localhost:3000/api/customer/google/callback
CUSTOMER_SMTP_HOST=
CUSTOMER_SMTP_PORT=587
CUSTOMER_SMTP_USER=
CUSTOMER_SMTP_PASSWORD=
CUSTOMER_SMTP_FROM=

# NeMo Guardrails
ENABLE_GUARDRAILS=true

# Offline RAGAS evaluation uses the same server-side key.
RAGAS_EVALUATOR_MODEL=gpt-4.1-mini
