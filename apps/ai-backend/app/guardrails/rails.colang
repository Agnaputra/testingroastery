# NVIDIA NeMo rail flows invoked by LLMRails.check() at input and output time.

define flow self check input
  $allowed = execute self_check_input
  if not $allowed
    bot refuse to respond
    stop

define flow self check output
  $allowed = execute self_check_output
  if not $allowed
    bot refuse to respond
    stop

define bot refuse to respond
  "Mohon maaf kawan seduh, saya hanya dapat membantu seputar katalog 52 Coffee, profil rasa, dan panduan seduh."
