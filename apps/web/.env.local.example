# 52 Coffee Web Frontend Environment Configuration
AI_BACKEND_URL=http://127.0.0.1:8013
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Private manual-payment testing data; never put real values in this example.
# These values are served only to authenticated owners of local testing orders.
PAYMENT_TEST_BCA_ACCOUNT=
PAYMENT_TEST_BCA_HOLDER=
PAYMENT_TEST_QRIS_MERCHANT=
PAYMENT_TEST_QRIS_PATH=

# Enable only on an isolated local testing instance.
NEXT_PUBLIC_CUSTOMER_COMMERCE_TEST_MODE=0
NEXT_PUBLIC_CUSTOMER_COMMERCE_MODE=disabled
# Production database checkout also requires CUSTOMER_COMMERCE_MODE=operational.
CUSTOMER_COMMERCE_MODE=disabled
PAYMENT_BCA_ACCOUNT=
PAYMENT_BCA_HOLDER=
PAYMENT_QRIS_MERCHANT=
PAYMENT_QRIS_PATH=public/qris.jpg
CUSTOMER_GOOGLE_CLIENT_ID=
CUSTOMER_GOOGLE_REDIRECT_URI=http://localhost:3000/api/customer/google/callback

# Admin portal two-step login. Generate the hash with:
# node -e "const c=require('crypto'),s=c.randomBytes(16);console.log(s.toString('hex')+':'+c.scryptSync(process.argv[1],s,32).toString('hex'))" "YOUR_PASSWORD"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
